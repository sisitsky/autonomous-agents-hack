  "equations": [
    {
      "id": "frequency_chain",
      "name": "Claim frequency (chain perils)",
      "formula": "\u03bb = N \u00d7 P(error) \u00d7 P(harm | error) \u00d7 P(claim | harm) [\u00d7 r_adv]",
      "latex": "\\lambda = N \\cdot P(\\text{error}) \\cdot P(\\text{harm}\\mid\\text{error}) \\cdot P(\\text{claim}\\mid\\text{harm})\\ [\\cdot\\, r_{adv}]",
      "meaning": "Expected claims per year from N outputs per year. r_adv applies only when P(error) comes from an adversarial red-team suite."
    },
    {
      "id": "frequency_rate",
      "name": "Claim frequency (rate perils)",
      "formula": "\u03bb = rate [\u00d7 \u03c1_leak]",
      "latex": "\\lambda = \\text{rate}\\ [\\cdot\\, \\rho_{leak}]",
      "meaning": "A direct annual claim rate. For the privacy peril, red-team data-leak results multiply it."
    },
    {
      "id": "red_team_beta",
      "name": "Red-team evidence",
      "formula": "P(error) ~ Beta(F + 1, T \u2212 F + 1)",
      "latex": "P(\\text{error}) \\sim \\mathrm{Beta}(F+1,\\ T-F+1)",
      "meaning": "F failures in T tested cases, updating a uniform prior. Fewer tests give a wider distribution and a larger uncertainty load. The same form is used for the leak rate on data-leak probes."
    },
    {
      "id": "adversarial_ratio",
      "name": "Adversarial suite adjustment",
      "formula": "P(error)_live = P(fail | probe) \u00d7 r_adv",
      "latex": "P(\\text{error})_{live} = P(\\text{fail}\\mid\\text{probe}) \\cdot r_{adv}",
      "meaning": "Stress-test suites over-sample failure modes, so the per-probe failure rate is scaled to a per-live-output rate by an uncertain ratio."
    },
    {
      "id": "leak_relativity",
      "name": "Data-leak relativity",
      "formula": "\u03c1_leak = clip(L / L_ref, min, max)",
      "latex": "\\rho_{leak} = \\mathrm{clip}\\!\\left(\\tfrac{L}{L_{ref}},\\ \\min,\\ \\max\\right)",
      "meaning": "The insured's leak rate on probes divided by a typical system's, bounded."
    },
    {
      "id": "rating_modifier",
      "name": "Rating-factor modifier",
      "formula": "M = clip(\u220f f_i, min, max)",
      "latex": "M = \\mathrm{clip}\\!\\left(\\prod_i f_i,\\ \\min,\\ \\max\\right)",
      "meaning": "Relativities of the rating factors that apply to the peril, multiplied, then capped so stacked factors can't produce extreme prices."
    },
    {
      "id": "claim_count",
      "name": "Claims in a simulated year",
      "formula": "n ~ Poisson(\u03bb \u00d7 M)",
      "latex": "n \\sim \\mathrm{Poisson}(\\lambda \\cdot M)",
      "meaning": "Claim count per simulated year for one peril."
    },
    {
      "id": "severity",
      "name": "Claim size",
      "formula": "X ~ Lognormal(\u03bc = ln m, \u03c3 = (ln p90 \u2212 ln m) / 1.2816); with probability q, X = T \u00d7 U^(\u22121/\u03b1)",
      "latex": "X \\sim \\mathrm{LN}\\!\\left(\\ln m,\\ \\tfrac{\\ln p_{90} - \\ln m}{1.2816}\\right);\\ \\text{w.p. } q:\\ X = T\\,U^{-1/\\alpha}",
      "meaning": "Lognormal body set by its median m and 90th percentile p90, plus an optional Pareto tail above threshold T with shape \u03b1 (lower \u03b1 = fatter tail)."
    },
    {
      "id": "policy_layer",
      "name": "Policy terms",
      "formula": "paid = min(max(X \u2212 d, 0), L_claim); annual total \u2264 A",
      "latex": "\\text{paid} = \\min(\\max(X - d, 0),\\ L_{claim});\\quad \\textstyle\\sum \\le A",
      "meaning": "Deductible d and per-claim limit apply to each claim; the aggregate limit A caps the year."
    },
    {
      "id": "systemic",
      "name": "Systemic event",
      "formula": "loss_sys = \u2113 \u00d7 A, if an event occurs (prob p_s) and hits this insured (prob s)",
      "latex": "\\text{loss}_{sys} = \\ell \\cdot A \\quad \\text{w.p. } p_s \\cdot s",
      "meaning": "A correlated failure at the insured's model provider (bad update, new jailbreak, adverse ruling)."
    },
    {
      "id": "expected_loss",
      "name": "Expected loss",
      "formula": "EL = mean over simulated years of min(idiosyncratic + systemic, A)",
      "latex": "EL = \\mathbb{E}\\left[\\min(\\text{idio} + \\text{sys},\\ A)\\right]",
      "meaning": "Two-layer Monte Carlo: n_outer parameter draws (what we don't know) \u00d7 n_inner years each (luck)."
    },
    {
      "id": "uncertainty_load",
      "name": "Parameter-uncertainty load",
      "formula": "U = max(0, P_k(EL by parameter draw) \u2212 EL)",
      "latex": "U = \\max\\!\\left(0,\\ P_k\\!\\left[EL_j\\right] - EL\\right)",
      "meaning": "Charges for not knowing the parameters: the gap between the k-th percentile of expected loss across parameter draws and its mean."
    },
    {
      "id": "capital",
      "name": "Risk capital",
      "formula": "C = (TVaR(idio) \u2212 mean(idio)) / \u221an_pool + c \u00d7 (TVaR(sys) \u2212 mean(sys))",
      "latex": "C = \\frac{\\mathrm{TVaR}(\\text{idio}) - \\overline{\\text{idio}}}{\\sqrt{n_{pool}}} + c\\,\\left(\\mathrm{TVaR}(\\text{sys}) - \\overline{\\text{sys}}\\right)",
      "meaning": "Independent losses diversify across the pool; systemic losses get no diversification credit."
    },
    {
      "id": "concentration",
      "name": "Provider concentration",
      "formula": "c = provider share of portfolio / average provider share",
      "latex": "c = \\frac{\\text{share}_{provider}}{\\overline{\\text{share}}}",
      "meaning": "Policies on heavily used model providers carry more systemic capital."
    },
    {
      "id": "capital_load",
      "name": "Capital load",
      "formula": "K = cost of capital \u00d7 C",
      "latex": "K = r_{coc} \\cdot C",
      "meaning": "The cost of holding the risk capital for a year."
    },
    {
      "id": "gross_premium",
      "name": "Gross premium",
      "formula": "G = (EL + U + K + F) / (1 \u2212 v \u2212 \u03c0)",
      "latex": "G = \\frac{EL + U + K + F}{1 - v - \\pi}",
      "meaning": "Technical premium (losses, loads, fixed expense F) grossed up for variable expenses v and profit \u03c0."
    },
    {
      "id": "rate_on_line",
      "name": "Rate on line",
      "formula": "ROL = G / A",
      "latex": "\\mathrm{ROL} = G / A",
      "meaning": "Premium as a share of the aggregate limit."
    }
  ]
